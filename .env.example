APP_NAME=Aeronance
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aeronance.example.org

# UI ist deutsch; Sprachdateien machen weitere Sprachen möglich.
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Gespeichert wird immer in UTC -- das ueberlebt Zeitumstellungen und macht
# Zeitstempel im Audit-Trail eindeutig. Angezeigt wird in der Vereinszeitzone.
APP_TIMEZONE=UTC
ORGANISATION_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Datenbank -------------------------------------------------------------
# Ausschliesslich MariaDB (Mindestversion 10.11 LTS). PostgreSQL, MySQL und
# SQLite werden nicht unterstuetzt -- auch nicht fuer Tests. Siehe CLAUDE.md.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aeronance
DB_USERNAME=aeronance
DB_PASSWORD=

# --- Vereinsspezifische Konfiguration --------------------------------------
# Nichts davon gehoert in den Code (Leitplanke: eine Instanz = ein Verein).
ORGANISATION_NAME="Mein Luftsportverein"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# Dokumente (Form 1, CRS, Fotos) liegen auf einer privaten Disk ausserhalb
# des Webroots und werden nur ueber auth-gepruefte Routen ausgeliefert.
FILESYSTEM_DISK=local

# Start-Default ist die Datenbank. Redis erst, wenn ein Feature es wirklich
# braucht -- dann aber regulaer in allen drei Auslieferungskanaelen.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="aeronance@example.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Nachweisdokumente (Form 1, CoC, spaeter CRS)
# Gilt fuer das Upload-Feld UND die Media Library -- beide lesen diesen Wert.
AERONANCE_DOCUMENT_MAX_MB=20

# Virenpruefung: none | clamav
# Bei clamav entweder Unix-Socket (gleicher Host) oder Host/Port (Docker).
# fail_closed=true lehnt Uploads ab, wenn der Scanner nicht erreichbar ist --
# eine Pruefung, die sich beim Absturz still abschaltet, ist keine.
AERONANCE_VIRUS_SCANNER=none
# AERONANCE_CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# AERONANCE_CLAMAV_HOST=clamav
# AERONANCE_CLAMAV_PORT=3310
# AERONANCE_CLAMAV_FAIL_CLOSED=true
# Sekunden, die auf den Scanner gewartet wird.
# AERONANCE_CLAMAV_TIMEOUT=30

# --- LTA/TM: Zugangsdaten für Herstellerabrufe --------------------------------
# Manche Hersteller geben ihre Technischen Mitteilungen nur an Kunden heraus.
# Die Herstellerdatei (resources/directive-sources/*.yaml) nennt nur den Namen
# des Profils -- die Zugangsdaten stehen hier, damit eine Spec teilbar bleibt
# und nie ein Passwort ins Repo oder in ein Backup trägt.
#
# Benannt wird nach dem Profil: `auth: schempp` in der YAML sucht hier
# DIRECTIVES_SCHEMPP_USER und DIRECTIVES_SCHEMPP_PASSWORD.
#
# DG braucht keine -- ist öffentlich.
DIRECTIVES_SCHEMPP_USER=
DIRECTIVES_SCHEMPP_PASSWORD=

# --- Faelligkeiten und Toleranzen --------------------------------------------
# Wie weit die Faelligkeitsliste nach vorne schaut.
# AERONANCE_DUE_WINDOW_DAYS=90
#
# Toleranzen auf Wartungsfristen. NUR aendern, wenn das
# Instandhaltungsprogramm sie hergibt -- hier steht keine Hausregel, sondern
# das, was das Programm des Luftfahrzeugs erlaubt.
# AERONANCE_TOLERANCE_MONTHS=1
# AERONANCE_TOLERANCE_PERCENT=10

# --- Aktualisierungspruefung -------------------------------------------------
# Schaut einmal taeglich nach, ob eine neuere Fassung veroeffentlicht wurde,
# und zeigt das Ergebnis auf der Startseite. Sie SCHAUT NUR NACH und
# installiert nichts -- eingespielt wird je nach Kanal mit deploy/update.sh,
# einem neuen Docker-Image oder dem LXC-Skript.
#
# Auf false gesetzt geht keine einzige Anfrage nach draussen. Eine Instanz ohne
# Internetzugang braucht das nicht, und wer nicht moechte, dass seine
# Installation nach aussen telefoniert, hat das Recht dazu.
# AERONANCE_UPDATE_CHECK=true
#
# Selbsttaetig aktualisieren -- AUS, bis jemand es einschaltet.
#
# Eingeschaltet laeuft naechtlich deploy/auto-update.sh (bzw.
# deploy/docker/auto-update.sh) ueber einen systemd-Timer. Es entscheidet nur,
# OB etwas zu tun ist, und ruft dann das regulaere Update-Skript auf -- mit
# Signaturpruefung, Sicherung, Wartungsmodus und Migration. Automatisiert wird
# also der ABLAUF, nicht der Weg daran vorbei.
#
# Waehrend 0.0.x weigert es sich: Dort sind Brueche zwischen zwei Fassungen
# ausdruecklich erlaubt, und die will niemand nachts um halb vier bekommen.
# AERONANCE_AUTO_UPDATE=false
#
# Woher die Veroeffentlichungen kommen. Der Vorgabewert ist das oeffentliche
# Repository des Projekts; wer einen eigenen Spiegel pflegt, traegt ihn hier ein.
# AERONANCE_UPDATE_REPOSITORY=maruether/aeronance
#
# Wie lange die Antwort zwischengespeichert wird. Ein Projekt veroeffentlicht
# keine zwei Fassungen am Tag, und ohne Zwischenspeicher liefe es in die
# Ratenbegrenzung von GitHub.
# AERONANCE_UPDATE_CACHE_HOURS=12
# AERONANCE_UPDATE_TIMEOUT=8

# --- Bestellungen ------------------------------------------------------------
# Der Zweck ist die Erinnerung an ueberfaellige Lieferungen, nicht Beschaffung.
#
# Vorbelegtes Lieferdatum: Bestelldatum plus so viele Tage. Viele Lieferanten
# sagen gar kein Datum zu -- ohne Vorbelegung gaebe es bei genau denen keine
# Erinnerung, also beim Lieferanten, der sich nicht meldet.
# AERONANCE_ORDER_LEAD_DAYS=7
#
# Abstand zwischen zwei Erinnerungen zur selben Bestellung. Ohne Abstand kaeme
# jeden Morgen dieselbe Mail, und die vierte identische wischt jeder weg.
# AERONANCE_ORDER_REMINDER_DAYS=3
