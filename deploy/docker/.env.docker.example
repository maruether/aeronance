# Aeronance im Container -- Beispielkonfiguration.
#
# Kopieren nach .env, ausfüllen, dann `docker compose up -d`.
# CLAUDE.md: keine Secrets im Repo -- diese Datei enthält deshalb keine.

APP_NAME=Aeronance
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Die Adresse, unter der der Verein die Anwendung aufruft. Steht ein Reverse
# Proxy davor, ist das DESSEN Adresse -- sonst baut die Anwendung Links, die
# ins Container-Netz zeigen.
APP_URL=https://werkstatt.example.org

# Sprache. Aeronance liefert nur Deutsch aus (lang/de).
#
# HIER FEHLTEN DIESE ZEILEN, und der Docker-Kanal ist der, wo das wirklich
# zugeschlagen haette: Laravel meldet eine fehlende Sprachdatei nicht -- es
# zeigt den SCHLUESSEL an. Eine Installation ohne diese Angabe startete mit
# einer Oberflaeche voller "users.field.name", mit HTTP 200 und ohne einen
# einzigen Fehlereintrag. Seit 0.0.1 ist die Vorgabe im Code richtig; hier
# steht es trotzdem, weil eine Vorlage sagen soll, was gilt.
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

# Das Sitzungscookie nur ueber HTTPS mitschicken.
#
# Steht ein Reverse Proxy davor, der HTTPS beendet, gilt das trotzdem: Was
# zaehlt, ist die Verbindung zwischen Browser und Proxy. Auf false nur, wenn
# der Verbund bewusst ueber http erreichbar sein soll -- was CLAUDE.md
# ausschliesst.
SESSION_SECURE_COOKIE=true

# Wo der Verbund lauscht.
#
# AERONANCE_BIND=127.0.0.1 hinter einem Reverse Proxy -- dann ist der Verbund
# NUR über ihn erreichbar. Ohne Proxy bleibt 0.0.0.0, und davor gehört dann
# etwas, das HTTPS spricht.
#
# Der Kommentar hier behauptete früher, 127.0.0.1 sei schon eingestellt. War es
# nicht: Die compose-Datei band an alle Schnittstellen. Jetzt steht beides hier
# und ist eine Zeile.
AERONANCE_BIND=0.0.0.0
AERONANCE_PORT=8080

# Das Image. Auf ein getaggtes Release zeigen, nicht auf latest: ein Update soll
# eine Entscheidung sein, kein Nebeneffekt eines Neustarts.
AERONANCE_IMAGE=registry.example.org/aeronance:v0.1.0

# Selbsttaetig aktualisieren -- AUS, bis jemand es einschaltet.
#
# Der Timer laeuft auf dem WIRT (deploy/docker/aeronance-update.timer) und ruft
# deploy/docker/auto-update.sh. Das entscheidet nur, OB etwas zu tun ist, und
# ruft dann update.sh -- mit Sicherung, Wartungsmodus und MIGRATION. Ein
# blosses `docker compose pull` laesst genau die Migration aus.
# AERONANCE_AUTO_UPDATE=false

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aeronance
DB_USERNAME=aeronance
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Vorgabe bleibt database -- CLAUDE.md: Redis wird erst Pflicht, wenn ein
# Feature es wirklich braucht.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Hinter einem Reverse Proxy zwingend: Erst ein VERTRAUTER Proxy macht die
# X-Forwarded-*-Header wirksam -- Client-IP fürs Audit-Log und den
# Login-Rate-Limiter, Schema für HSTS und signierte URLs. "*" traut jedem
# Absender und ist nur richtig, solange der nginx-Port nicht selbst im Netz
# hängt; sonst hier die Adresse(n) des Proxys eintragen, kommagetrennt,
# CIDR erlaubt (z. B. 172.18.0.0/16).
TRUSTED_PROXIES=*
